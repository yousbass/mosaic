{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["vitest/globals"]
  },
  "include": ["src"]
}
